# App
APP_ENV=development
APP_PORT=8000

# SEC EDGAR
SEC_USER_AGENT=YourName your@email.com

# Database
DATABASE_URL=sqlite:///./intelligence.db

# Redis cache (optional — the app degrades gracefully if Redis is unreachable)
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds for yfinance fundamentals (900 = 15 minutes)
CACHE_TTL=900

# CORS — comma-separated allowed origins (do not use "*" in production)
CORS_ORIGINS=http://localhost:8765,http://localhost:3000

# Per-IP rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ANALYZE=10/minute

# JWT auth — MUST set a strong JWT_SECRET and ADMIN_PASSWORD before deploying
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Self-scoring track record — prediction horizons in months
PREDICTION_HORIZONS=3,6,12
